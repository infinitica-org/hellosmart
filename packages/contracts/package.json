{
  "name": "@hs/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "redocly lint openapi/openapi.yaml && tsc --noEmit -p tsconfig.json",
    "generate": "openapi-typescript openapi/openapi.yaml -o src/generated/api.ts",
    "mock": "prism mock -p 4010 openapi/openapi.yaml",
    "lint": "redocly lint openapi/openapi.yaml",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "echo \"contracts: lint is the test\""
  },
  "dependencies": {
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@redocly/cli": "1.25.11",
    "@stoplight/prism-cli": "5.12.0",
    "openapi-typescript": "7.4.2",
    "typescript": "5.6.3"
  }
}
