{
  "name": "@hs/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "redocly lint openapi/openapi.yaml && tsc --noEmit -p tsconfig.json",
    "generate": "openapi-typescript openapi/openapi.yaml -o src/generated/api.ts",
    "mock": "prism mock -p 4010 openapi/openapi.yaml",
    "lint": "redocly lint openapi/openapi.yaml",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test test/schemas.test.ts test/password-policy.test.ts",
    "test:mock": "node test/prism-verify.mjs"
  },
  "dependencies": {
    "zod": "3.25.76",
    "zxcvbn": "4.4.2"
  },
  "devDependencies": {
    "@redocly/cli": "1.34.22",
    "@stoplight/prism-cli": "5.16.0",
    "@types/zxcvbn": "4.4.5",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3"
  }
}
