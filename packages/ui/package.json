{
  "name": "@hs/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./styles/*": "./src/styles/*",
    "./fonts/*": "./src/fonts/*",
    "./hellosmart/*": "./src/hellosmart/*",
    "./src/*": "./src/*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "storybook": "storybook dev -p 6006 --disable-telemetry",
    "build-storybook": "storybook build --disable-telemetry"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "8.6.19",
    "@storybook/addon-essentials": "8.6.14",
    "@storybook/addon-interactions": "8.6.14",
    "@storybook/react": "8.6.19",
    "@storybook/react-vite": "8.6.19",
    "@storybook/test": "8.6.15",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/zxcvbn": "4.4.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "10.6.2",
    "postcss": "8.5.32",
    "storybook": "8.6.19",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "vite": "^5.4.11"
  },
  "dependencies": {
    "lucide-react": "^1.66.0",
    "recharts": "3.10.1",
    "zxcvbn": "4.4.2"
  }
}
