{
  "name": "@hs/fixtures",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "hs-seed": "dist/index.js",
    "hs-verify": "dist/verify.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "seed": "pnpm build && node dist/index.js",
    "seed:direct": "pnpm build && node dist/seed.js",
    "verify": "pnpm build && node dist/verify.js",
    "test": "node --test --test-concurrency=1 test/credentials.test.ts test/entities.test.ts test/guard.test.ts test/upsert.test.ts test/invitations.test.ts test/seed.test.ts test/verify.test.ts test/auth-compatibility.test.ts test/seed-safety.test.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "2.2.2",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "8.23.1",
    "otplib": "12.0.1",
    "typescript": "5.9.3"
  }
}
