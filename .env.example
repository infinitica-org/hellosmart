# ==============================================================================
# HelloSmart.ai — Local Development Environment Variables
# ==============================================================================
# NOTE: Placeholder values only. Never put real API keys or production secrets here.
# Copy this file to .env:
#   cp .env.example .env
# ==============================================================================

# Node Environment
NODE_ENV=development

# ------------------------------------------------------------------------------
# Service URLs
# ------------------------------------------------------------------------------

LOG_LEVEL=info

APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Database (PostgreSQL 16)
# ------------------------------------------------------------------------------
# Container configuration
POSTGRES_USER=hs_owner
POSTGRES_PASSWORD=hs_owner_local
POSTGRES_DB=hellosmart
POSTGRES_PORT=5432

# Connection URLs for segregated database roles
# hs_app: Runtime application role with strict RLS (NOBYPASSRLS) used by apps/api
DATABASE_URL=postgres://hs_app:hs_app_local@localhost:5432/hellosmart

# hs_migrator: Schema migration role used by 'pnpm db:migrate'
DATABASE_MIGRATOR_URL=postgres://hs_migrator:hs_migrator_local@localhost:5432/hellosmart


# hs_owner: Root database owner for admin/bootstrap operations
DATABASE_OWNER_URL=postgres://hs_owner:hs_owner_local@localhost:5432/hellosmart

# ------------------------------------------------------------------------------
# Redis (Redis 7)
# ------------------------------------------------------------------------------
REDIS_PORT=6379
REDIS_PASSWORD=hs_redis_local
REDIS_URL=redis://:hs_redis_local@localhost:6379

# ------------------------------------------------------------------------------
# Session & Cookie Security
# ------------------------------------------------------------------------------
COOKIE_NAME=hs_session
COOKIE_SECRET=change-me-local-only-cookie-secret-32-chars-min
SESSION_SECRET=change-me-local-only-session-secret-32-bytes
SESSION_TTL_SECONDS=86400
PROXY_TOKEN_SIGNING_KEY=change-me-local-only-signing-key

# ------------------------------------------------------------------------------
# AWS LocalStack (Mock Cloud Infrastructure)
# ------------------------------------------------------------------------------

# Local only: used by pnpm db:migrate when app/audit schemas are missing (hs_owner superuser).
DATABASE_ADMIN_URL=postgres://hs_owner:hs_owner_local@127.0.0.1:5432/hellosmart
REDIS_URL=redis://:hs_redis_local@127.0.0.1:6379
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

AWS_REGION=ap-south-1
AWS_ENDPOINT_URL=http://localhost:4566
OBJECT_STORE_BUCKET=hs-local-artifacts
QUEUE_URL=http://localhost:4566/000000000000/hs-local-jobs
KMS_KEY_ID=alias/hs-local

# ------------------------------------------------------------------------------
# Local Adapters (fake | real)
# ------------------------------------------------------------------------------
PAYMENT_GATEWAY=fake
EMAIL_PROVIDER=fake
MAILPIT_URL=http://localhost:8025
LLM_PROVIDER=fake
WORKSPACE_RUNTIME=fake
EMAIL_FROM_DOMAIN=mail.hellosmart.local

# ------------------------------------------------------------------------------
# Third-Party Provider Credentials (Optional / Placeholders for dev)
# ------------------------------------------------------------------------------
GOOGLE_OAUTH_CLIENT_ID=mock-google-client-id
GOOGLE_OAUTH_CLIENT_SECRET=mock-google-client-secret
MS_OAUTH_CLIENT_ID=mock-ms-client-id
MS_OAUTH_CLIENT_SECRET=mock-ms-client-secret
RAZORPAY_KEY_ID=rzp_test_mock_key
RAZORPAY_KEY_SECRET=mock_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=mock_webhook_secret
CALCOM_WEBHOOK_SECRET=mock_calcom_secret
