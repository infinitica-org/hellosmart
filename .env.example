# Local development only. Real values live in AWS Secrets Manager / SSM. Never commit a filled .env.
NODE_ENV=development
LOG_LEVEL=info
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:4000
DATABASE_URL=postgres://hs_app:hs_app_local@localhost:5432/hellosmart
DATABASE_MIGRATOR_URL=postgres://hs_migrator:hs_migrator_local@localhost:5432/hellosmart
# Local only: used by pnpm db:migrate when app/audit schemas are missing (hs_owner superuser).
DATABASE_ADMIN_URL=postgres://hs_owner:hs_owner_local@127.0.0.1:5432/hellosmart
REDIS_URL=redis://:hs_redis_local@127.0.0.1:6379
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
AWS_REGION=ap-south-1
AWS_ENDPOINT_URL=http://localhost:4566
OBJECT_STORE_BUCKET=hs-local-artifacts
QUEUE_URL=http://localhost:4566/000000000000/hs-local-jobs
KMS_KEY_ID=alias/hs-local
SESSION_SECRET=change-me-local-only-32-bytes-minimum
# Base32 TOTP secret for local platform admin MFA (seed uses env:PLATFORM_ADMIN_MFA_SECRET)
PLATFORM_ADMIN_MFA_SECRET=JBSWY3DPEHPK3PXP
# 32-byte (256-bit) AES-GCM key for MFA secrets at rest (hex, base64, or 32 raw bytes). Required in staging/production.
MFA_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
MFA_ENCRYPTION_KEY_ID=k1
# Optional previous keys for zero-downtime key rotation (JSON or key:value format)
# MFA_PREVIOUS_ENCRYPTION_KEYS={"k0":"0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"}
PROXY_TOKEN_SIGNING_KEY=change-me-local-only
# adapters: fake | real
PAYMENT_GATEWAY=fake
EMAIL_PROVIDER=fake
MAILPIT_URL=http://localhost:8025
LLM_PROVIDER=fake
WORKSPACE_RUNTIME=fake
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
MS_OAUTH_CLIENT_ID=
MS_OAUTH_CLIENT_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
CALCOM_WEBHOOK_SECRET=
EMAIL_FROM_DOMAIN=mail.hellosmart.local
