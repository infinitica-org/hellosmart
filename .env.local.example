# Local Development & Seed Environment Variables
# Copy this file to .env.local and configure values for local execution.
# NEVER commit .env.local or any real secrets to git.

# Shared local test password used for active loginable seed accounts.
# Must be set when running `pnpm db:seed`.
SEED_DEFAULT_PASSWORD=

# Explicit opt-in required to execute database fixture seeding in non-production environments.
ALLOW_NON_PRODUCTION_SEED=true

# Platform Admin TOTP Base32 secret for superadmin@hellosmart.ai (local development only).
# Format: standard base32 string (e.g. 32 characters, uppercase letters and digits 2-7).
# To use in an authenticator app locally, copy this value directly into your authenticator app.
# Note: Seed stores 'env:PLATFORM_ADMIN_MFA_SECRET'. Set both for seed & API compatibility.
SEED_PLATFORM_ADMIN_TOTP_SECRET=
PLATFORM_ADMIN_MFA_SECRET=
