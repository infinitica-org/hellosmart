{
  "name": "@hs/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nest build && node --env-file=../../.env ./node_modules/@nestjs/cli/bin/nest.js start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:stack": "vitest run test/stack-e2e.test.ts",
    "test:tenancy": "vitest run --project tenancy --passWithNoTests",
    "db:migrate": "nest build && node --env-file=../../.env dist/db/migrate.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1152.0",
    "@aws-sdk/s3-request-presigner": "3.1152.0",
    "@fastify/compress": "7.0.3",
    "@fastify/cookie": "9.4.0",
    "@fastify/helmet": "11.1.1",
    "@fastify/multipart": "8.3.1",
    "@hs/adapters": "workspace:*",
    "@hs/contracts": "workspace:*",
    "@nestjs/common": "10.4.6",
    "@nestjs/core": "10.4.6",
    "@nestjs/platform-fastify": "10.4.6",
    "@nestjs/throttler": "6.2.1",
    "@node-rs/argon2": "2.0.0",
    "@opentelemetry/api": "1.9.0",
    "@opentelemetry/exporter-metrics-otlp-http": "0.57.1",
    "@opentelemetry/exporter-trace-otlp-http": "0.57.1",
    "@opentelemetry/instrumentation-http": "0.57.1",
    "@opentelemetry/instrumentation-pg": "0.52.0",
    "@opentelemetry/resources": "1.30.1",
    "@opentelemetry/sdk-metrics": "1.30.1",
    "@opentelemetry/sdk-node": "0.57.1",
    "@opentelemetry/semantic-conventions": "1.28.0",
    "bullmq": "5.34.5",
    "bullmq": "5.34.5",
    "diff": "9.0.0",
    "drizzle-orm": "0.36.0",
    "ioredis": "6.0.0",
    "otplib": "12.0.1",
    "pg": "8.13.1",
    "pino": "9.5.0",
    "redis": "4.7.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1",
    "tar-stream": "3.1.7",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@nestjs/cli": "10.4.5",
    "@nestjs/testing": "10.4.6",
    "@types/node": "^22.7.5",
    "@types/pg": "8.11.10",
    "@types/tar-stream": "3.1.5",
    "fastify": "4.28.1",
    "typescript": "5.6.3",
    "vitest": "2.1.4"
  }
}
