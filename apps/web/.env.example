# HelloSmart Web Application Local Environment
# Prism mock server runs on port 4010; Real API runs on port 4000
NEXT_PUBLIC_API_URL=http://localhost:4010/api/v1
NEXT_PUBLIC_APP_ENV=development

# ------------------------------------------------------------------------------
# Development-only mock account fallback
# Enable ONLY in local development when the backend API is not running.
# NEVER set this in staging or production — demo accounts bypass real auth.
# ------------------------------------------------------------------------------
# ENABLE_DEV_ACCOUNTS=true
