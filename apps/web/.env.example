# ==============================================================================
# HelloSmart Web Application Local Environment (apps/web)
# ==============================================================================
# Copy this file to apps/web/.env.local (or define in root .env):
#   cp apps/web/.env.example apps/web/.env.local
# ==============================================================================

# ------------------------------------------------------------------------------
# Public Variables (Injected into Client JavaScript Bundles)
# ------------------------------------------------------------------------------
# WARNING: NEVER put secrets, tokens, or private credentials in NEXT_PUBLIC_* variables.
# Browser-accessible backend API base URL
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Browser-accessible frontend application origin
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Client-facing environment badge (development | test | staging | production)
NEXT_PUBLIC_APP_ENV=development

# ------------------------------------------------------------------------------
# Server-Side BFF Variables (Node.js Server Only — NEVER in Client Bundle)
# ------------------------------------------------------------------------------
# Internal backend API URL for server-to-server Fastify calls from Route Handlers
API_BASE_URL=http://localhost:4000

# Internal application origin for constructing callback redirects
APP_BASE_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Development-Only Feature Toggles
# ------------------------------------------------------------------------------
# Enable ONLY in local development when the backend API is not running.
# NEVER set this in staging or production — demo accounts bypass real authentication.
# ENABLE_DEV_ACCOUNTS=true
