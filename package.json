{
  "name": "hellosmart",
  "private": true,
  "packageManager": "pnpm@9.12.3",
  "engines": { "node": ">=22.11.0", "pnpm": ">=9.12.0" },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:tenancy": "turbo run test:tenancy",
    "test:e2e": "pnpm --filter @hs/e2e test",
    "mock": "pnpm --filter @hs/contracts mock",
    "contracts:check": "pnpm --filter @hs/contracts check",
    "db:migrate": "pnpm --filter @hs/api db:migrate",
    "db:seed": "pnpm --filter @hs/fixtures seed",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "secrets:scan": "gitleaks detect --no-banner --redact",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@hs/config": "workspace:*",
    "prettier": "3.3.3",
    "turbo": "2.2.3",
    "typescript": "7.0.2"
  }
}
