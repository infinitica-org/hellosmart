{
  "name": "hellosmart",
  "private": true,
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": ">=22.11.0",
    "pnpm": ">=9.12.0"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:tenancy": "turbo run test:tenancy",
    "test:e2e": "pnpm --filter @hs/e2e test",
    "mock": "pnpm --filter @hs/contracts mock",
    "contracts:check": "pnpm --filter @hs/contracts check",
    "db:migrate": "pnpm --filter @hs/api db:migrate",
    "db:seed": "pnpm --filter @hs/fixtures seed",
    "db:verify-seed": "pnpm --filter @hs/fixtures verify",
    "dev:up": "docker compose up -d",
    "dev:down": "docker compose down",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "docs:dev": "pnpm --dir apps/docs dev",
    "docs:build": "pnpm --dir apps/docs build",
    "docs:sync-check": "node scripts/aidlc-docs-check.mjs",
    "matrix:verify": "node scripts/verify-traceability.mjs",
    "secrets:scan": "gitleaks detect --no-banner --redact",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@hs/config": "workspace:*",
    "@playwright/test": "^1.64.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prettier": "3.9.10",
    "turbo": "2.11.10",
    "typescript": "5.9.3"
  },
  "overrides": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0"
  }
}
