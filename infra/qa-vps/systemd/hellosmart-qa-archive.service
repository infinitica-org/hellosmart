[Unit]
Description=HelloSmart QA Container Log Ingestion and 7-Day Archival
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=deploy
Group=deploy
WorkingDirectory=/srv/hellosmart
ExecStart=/bin/bash -c "if [ -x /srv/hellosmart/qa-archive.sh ]; then exec /srv/hellosmart/qa-archive.sh; elif [ -x /srv/hellosmart/infra/qa-vps/qa-archive.sh ]; then exec /srv/hellosmart/infra/qa-vps/qa-archive.sh; else echo 'qa-archive.sh not found' >&2; exit 1; fi"
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
