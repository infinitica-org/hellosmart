# Copy to /srv/hellosmart/.env.qa on the VPS (chmod 600). Never commit real values.
NODE_ENV=staging
REGISTRY=ghcr.io/infinitica-org
TAG=latest
APP_BASE_URL=https://qa.hellosmart.ai
API_BASE_URL=https://api.qa.hellosmart.ai
CORS_ORIGINS=https://qa.hellosmart.ai

POSTGRES_DB=hellosmart
POSTGRES_USER=hs_owner
POSTGRES_PASSWORD=__generate_with_openssl_rand_base64_32__
DATABASE_URL=postgres://hs_app:__app_password__@postgres:5432/hellosmart
REDIS_PASSWORD=__generate__
REDIS_URL=redis://:__generate__@redis:6379

AWS_REGION=ap-south-1
AWS_ENDPOINT_URL=http://localstack:4566
SESSION_SECRET=__generate_64_chars__

# QA uses fake payments + Mailpit email; real LLM with a low-cap QA key is allowed.
PAYMENT_GATEWAY=fake
EMAIL_PROVIDER=fake
LLM_PROVIDER=fake
WORKSPACE_RUNTIME=sysbox

QA_ALLOWED_IPS=203.0.113.10/32 198.51.100.0/24
QA_BASIC_USER=qa
QA_BASIC_HASH=__caddy_hash-password_output__
