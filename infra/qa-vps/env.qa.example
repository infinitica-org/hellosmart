# ==============================================================================
# HelloSmart.ai — QA VPS Environment Variables
# ==============================================================================
# Copy to /srv/hellosmart/.env.qa on the QA EC2 instance (chmod 600).
# NEVER commit real values. All secrets must be generated at deploy time.
# ==============================================================================

NODE_ENV=staging
REGISTRY=ghcr.io/infinitica-org
TAG=latest
APP_BASE_URL=https://qa.hellosmart.ai
API_BASE_URL=https://api.qa.hellosmart.ai
CORS_ORIGINS=https://qa.hellosmart.ai

POSTGRES_DB=hellosmart
POSTGRES_USER=hs_owner
POSTGRES_PASSWORD=__generate_with_openssl_rand_base64_32__

# Database roles (PostgreSQL 16 with Row-Level Security)
DATABASE_URL=postgres://hs_app:__app_password__@postgres:5432/hellosmart
DATABASE_MIGRATOR_URL=postgres://hs_migrator:__migrator_password__@postgres:5432/hellosmart
DATABASE_PLATFORM_URL=postgres://hs_platform:__platform_password__@postgres:5432/hellosmart

REDIS_PASSWORD=__generate_with_openssl_rand_base64_32__
REDIS_URL=redis://:__generate_with_openssl_rand_base64_32__@redis:6379

AWS_REGION=ap-south-1
AWS_ENDPOINT_URL=http://localstack:4566
COOKIE_SECRET=__generate_32_chars_minimum__
SESSION_SECRET=__generate_64_chars__

# QA uses fake payments + Mailpit email; real LLM with a low-cap QA key is allowed.
PAYMENT_GATEWAY=fake
EMAIL_PROVIDER=fake
LLM_PROVIDER=fake
WORKSPACE_RUNTIME=sysbox

QA_ALLOWED_IPS=203.0.113.10/32 198.51.100.0/24
QA_BASIC_USER=qa
QA_BASIC_HASH=__caddy_hash-password_output__
