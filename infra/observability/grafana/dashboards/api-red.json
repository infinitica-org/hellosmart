{
  "title": "HelloSmart API RED",
  "uid": "hs-api-red",
  "schemaVersion": 38,
  "timezone": "browser",
  "panels": [
    {
      "type": "stat",
      "title": "Requests / s",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 0 },
      "targets": [{ "expr": "sum(rate(hs_http_requests_total[5m]))", "refId": "A" }]
    },
    {
      "type": "stat",
      "title": "5xx / s",
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 0 },
      "targets": [{ "expr": "sum(rate(hs_http_errors_total[5m]))", "refId": "A" }]
    },
    {
      "type": "timeseries",
      "title": "Duration p95",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 6 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(hs_http_duration_milliseconds_bucket[5m])) by (le, route))",
          "refId": "A"
        }
      ]
    }
  ]
}
